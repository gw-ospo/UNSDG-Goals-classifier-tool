# Copy this file to `.env` in the repository root and fill in your values.
# The backend loads it automatically; `.env` itself is git-ignored.

# Required — raises the GitHub API rate limit when fetching repository data.
# Guide: https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens
GITHUB_TOKEN=

# Optional — enables LLM summarisation of READMEs. Without it the backend
# falls back to a non-LLM summary instead of failing.
# Sign up at https://www.groq.com/ and create a project to get a key.
GROQ_API_KEY=

# Optional — only needed if you hit rate limits downloading model weights
# from the Hugging Face Hub.
# Guide: https://huggingface.co/docs/hub/en/security-tokens
HF_TOKEN=
