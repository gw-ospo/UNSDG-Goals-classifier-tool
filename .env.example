# Guide: https://docs.github.com/en/authentication/keeping-your-account-and-data-secure/managing-your-personal-access-tokens
GITHUB_TOKEN=

# Sign up at https://www.groq.com/ and create a project to get a key.
GROQ_API_KEY=

# Guide: https://huggingface.co/docs/hub/en/security-tokens
HF_TOKEN=

# Optional. Leave empty to run SDG inference in-process (the default).
# Set it to a URL to call a remote model service over HTTP instead — the seam
# that lets the classifier move onto its own host for GPU or independent scaling.
MODEL_SERVICE_URL=

BACKEND_PORT=8010

# Local development only. 1 enables the Werkzeug debugger, which runs arbitrary code on error.
FLASK_DEBUG=0
