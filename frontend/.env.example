# Copy this file to `frontend/.env.local` and adjust as needed.
# `.env.local` is git-ignored.
#
# Next.js reads env files from this directory (the Next project root), NOT from
# the repository root — the root `.env` used by the backend is not visible here.

# Base URL of the Flask backend, as reached from the user's BROWSER.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time, so this
# must be set before `npm run build`. Changing it later requires a rebuild.
# It must be a publicly reachable URL in a deployed environment — an internal
# container name such as http://backend:8010 will not resolve in the browser.
#
# Defaults to http://127.0.0.1:8010 when unset, which matches local development.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010
